@page "/events"
@attribute [Authorize]
@inject ITalksOpsApiClient Api
@inject IJSRuntime JavaScript
@inject IServiceProvider ServiceProvider
@using Microsoft.Extensions.DependencyInjection

<PageTitle>Events | TalksOps</PageTitle>

<div class="page-heading">
    <div><p class="eyebrow">YOUR SPEAKING PIPELINE</p><h1>Events</h1></div>
    <div class="event-create" @onkeydown="HandleEventCreateKeyDown">
        <div class="event-create-buttons @(this.IsAiExtractionEnabled ? "event-create-split" : string.Empty)">
            <button class="button button-primary" type="button" @onclick="BeginCreateEvent">New event <span aria-hidden="true">+</span></button>
            @if (this.IsAiExtractionEnabled)
            {
                <button class="button button-primary event-create-toggle" type="button" aria-label="More event creation options" title="More event creation options" aria-expanded="@(this.IsEventCreateMenuOpen ? "true" : "false")" aria-controls="event-create-options" @onclick="ToggleEventCreateMenu"><span aria-hidden="true">&#9662;</span></button>
            }
        </div>
        @if (this.IsAiExtractionEnabled && this.IsEventCreateMenuOpen)
        {
            <div class="event-create-menu-backdrop" role="presentation" @onclick="CloseEventCreateMenu"></div>
            <div id="event-create-options" class="event-create-menu">
                <button class="button button-primary" type="button" @onclick="OpenExtractionDialog">Extract from URL</button>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(this.ErrorMessage))
{
    <div class="notice notice-error" role="alert">@this.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(this.SuccessMessage))
{
    <div class="notice notice-success" role="status">@this.SuccessMessage</div>
}

<form class="filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <label>Year<input type="number" min="1" max="9999" @bind="this.SearchYear" /></label>
    <label>Event name<input type="search" placeholder="Search events" @bind="this.SearchName" /></label>
    <label>Location<input type="search" placeholder="City or venue" @bind="this.SearchLocation" /></label>
    <button class="button button-secondary" type="submit">Search</button>
</form>

<div class="calendar-legend" aria-label="Calendar status legend">
    <span><i class="calendar-dot accepted"></i> Accepted</span><span><i class="calendar-dot submitted"></i> Submitted</span>
    <span><i class="calendar-dot rejected"></i> Rejected</span><span><i class="calendar-dot cancelled"></i> Cancelled</span>
</div>

@if (this.IsLoading)
{
    <p class="empty-state">Loading events...</p>
}
else if (this.EventItems.Count == 0)
{
    <section class="empty-state"><h2>No events found</h2><p>Try another search or add an event to start planning.</p></section>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Event</th><th>Dates</th><th>Location</th><th>Costs</th><th>Call for papers deadline</th><th>Proposals</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var eventItem in this.EventItems)
                {
                    this.ProposalStatuses.TryGetValue(eventItem.Id, out var statuses);
                    <tr @key="eventItem.Id">
                        <td class="event-name">
                            @if (!string.IsNullOrWhiteSpace(eventItem.OfficialWebsiteUrl))
                            {
                                <a class="event-title-link" href="@eventItem.OfficialWebsiteUrl" target="_blank" rel="noopener noreferrer">@eventItem.Name</a>
                            }
                            else
                            {
                                @eventItem.Name
                            }
                            @if (!string.IsNullOrWhiteSpace(eventItem.CallForPapersUrl))
                            {
                                <a class="call-for-papers-link" href="@eventItem.CallForPapersUrl" target="_blank" rel="noopener noreferrer">call for paper</a>
                            }
                        </td>
                        <td>
                            @if (eventItem.StartDate == eventItem.EndDate)
                            {
                                @eventItem.StartDate.ToString("MMM d, yyyy")
                            }
                            else
                            {
                                @eventItem.StartDate.ToString("MMM d") <text>&ndash;</text> @eventItem.EndDate.ToString("MMM d, yyyy")
                            }
                        </td>
                        <td>@eventItem.Location</td>
                        <td>@(eventItem.Costs.Count == 0 ? "None" : eventItem.TotalCosts.ToString("N2", CultureInfo.InvariantCulture))</td>
                        <td>
                            @if (eventItem.CallForPapersDeadline is DateOnly deadline)
                            {
                                var deadlineStatus = CallForPapersDeadlineClassifier.Classify(deadline, DateOnly.FromDateTime(DateTime.Today));
                                <span class="deadline-date @deadlineStatus.ColorClass">@deadline.ToString("MMM d, yyyy")</span>
                                <span class="status-pill deadline-count @deadlineStatus.ColorClass">@deadlineStatus.RemainingLabel</span>
                            }
                            else
                            {
                                <span class="muted">Not set</span>
                            }
                        </td>
                        <td>
                            <div class="proposal-summary">
                                <button class="text-button" aria-expanded="@(this.ExpandedEventId == eventItem.Id)" @onclick="() => ToggleProposalsAsync(eventItem.Id)">
                                    @(this.ExpandedEventId == eventItem.Id ? "Hide" : "Manage") proposals
                                    @if (statuses is not null)
                                    {
                                        <text> (@statuses.Count)</text>
                                    }
                                </button>
                                @if (statuses is not null)
                                {
                                    <span class="proposal-indicators">
                                        @foreach (var status in statuses)
                                        {
                                            <span class="calendar-dot @CalendarStateClassifier.GetProposalState(status)" role="img" title="@status" aria-label="@($"Proposal status: {status}")"></span>
                                        }
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="row-actions">
                            <button class="icon-button" title="Edit event" aria-label="Edit @eventItem.Name" @onclick="() => BeginEditEvent(eventItem)">Edit</button>
                            <button class="icon-button danger" title="Delete event" aria-label="Delete @eventItem.Name" @onclick="() => DeleteEventAsync(eventItem)">Delete</button>
                        </td>
                    </tr>
                    @if (this.ExpandedEventId == eventItem.Id)
                    {
                        <tr class="detail-row">
                            <td colspan="7">
                                <div class="detail-heading"><h2>Session proposals</h2><button class="button button-secondary button-small" @onclick="() => BeginCreateProposal(eventItem.Id)">Add proposal</button></div>
                                @if (this.Proposals.TryGetValue(eventItem.Id, out var eventProposals) && eventProposals.Count > 0)
                                {
                                    <div class="proposal-list">
                                        @foreach (var proposal in eventProposals)
                                        {
                                            <article class="proposal-row" @key="proposal.Id">
                                                <div>
                                                    <h3>@proposal.Title</h3>
                                                    <p>@proposal.Notes</p>
                                                    @if (proposal.SubmissionDate is DateOnly submissionDate)
                                                    {
                                                        <p>Submission date: @submissionDate.ToString("yyyy-MM-dd")</p>
                                                    }
                                                </div>
                                                <span class="status-pill status-@proposal.Status.ToString().ToLowerInvariant()">@proposal.Status</span>
                                                <label class="status-control">Status
                                                    <select value="@((int)proposal.Status)" @onchange="args => UpdateProposalStatusAsync(eventItem.Id, proposal, args.Value?.ToString())">
                                                        <option value="@((int)ProposalStatus.Submitted)">Submitted</option>
                                                        <option value="@((int)ProposalStatus.Accepted)">Accepted</option>
                                                        <option value="@((int)ProposalStatus.Rejected)">Rejected</option>
                                                        <option value="@((int)ProposalStatus.Cancelled)">Cancelled</option>
                                                    </select>
                                                </label>
                                                <div class="row-actions"><button class="text-button" @onclick="() => BeginEditProposal(eventItem.Id, proposal)">Edit</button><button class="text-button danger" @onclick="() => DeleteProposalAsync(eventItem.Id, proposal)">Delete</button></div>
                                            </article>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="muted">No proposals for this event yet.</p>
                                }
                                @if (this.ProposalEditorEventId == eventItem.Id)
                                {
                                    <form class="editor-form" @onsubmit="SaveProposalAsync" @onsubmit:preventDefault>
                                        <h3>@(this.ProposalEditorId is null ? "New proposal" : "Edit proposal")</h3>
                                        <div class="form-grid">
                                            <label>Session title<input required maxlength="200" @bind="this.ProposalTitle" /></label>
                                            <label>Submission date<input type="date" @bind="this.ProposalSubmissionDate" /></label>
                                            <label class="span-all">Abstract<textarea rows="4" @bind="this.ProposalAbstract"></textarea></label>
                                            <label class="span-all">Notes<textarea rows="3" @bind="this.ProposalNotes"></textarea></label>
                                        </div>
                                        <div class="form-actions"><button class="button button-primary" type="submit">Save proposal</button><button class="button button-quiet" type="button" @onclick="CloseProposalEditor">Discard</button></div>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (this.IsAiExtractionEnabled && this.IsAiExtractionDialogOpen)
{
    <div class="dialog-backdrop" role="presentation">
        <section class="dialog extraction-dialog" role="dialog" aria-modal="true" aria-labelledby="extraction-title" aria-busy="@(this.IsExtracting ? "true" : "false")">
            <h2 id="extraction-title">Call for paper website</h2>
            <form @onsubmit="ExtractEventDataAsync" @onsubmit:preventDefault novalidate>
                @if (!string.IsNullOrWhiteSpace(this.ExtractError))
                {
                    <div id="extraction-error" class="notice notice-error" role="alert">@this.ExtractError</div>
                }
                <label for="extract-source-url">Call-for-papers page URL</label>
                <input id="extract-source-url" type="url" maxlength="2048" required disabled="@this.IsExtracting" aria-invalid="@(this.ExtractError is not null ? "true" : "false")" aria-describedby="@(this.ExtractError is not null ? "extraction-error" : null)" @bind="this.ExtractSourcePageUrl" @bind:event="oninput" />
                @if (this.IsExtracting)
                {
                    <p class="muted" role="status">Extracting...</p>
                }
                <div class="form-actions">
                    <button class="button button-quiet" type="button" disabled="@this.IsExtracting" @onclick="CloseExtractionDialog">Cancel</button>
                    <button class="button button-primary" type="submit" disabled="@this.IsExtracting">Extract</button>
                </div>
            </form>
        </section>
    </div>
}

@if (this.IsEventEditorOpen)
{
    <div class="dialog-backdrop" role="presentation" @onclick="CloseEventEditor">
        <section class="dialog event-dialog" role="dialog" aria-modal="true" aria-labelledby="event-editor-title" @onclick:stopPropagation>
            <div class="detail-heading"><h2 id="event-editor-title">@(this.EventEditorId is null ? "New event" : "Edit event")</h2><button class="icon-button" aria-label="Close" @onclick="CloseEventEditor">Close</button></div>
            <form @onsubmit="SaveEventAsync" @onsubmit:preventDefault>
                @if (!string.IsNullOrWhiteSpace(this.EventEditorErrorMessage))
                {
                    <div class="notice notice-error" role="alert">@this.EventEditorErrorMessage</div>
                }
                <div class="form-grid">
                    <label>Event name<input required maxlength="160" @bind="this.EventName" @bind:event="oninput" @bind:after="this.RefreshDuplicateEventNameAsync" /></label>
                    <label>Location<input required maxlength="160" @bind="this.EventLocation" /></label>
                    <div class="website-field">
                        <label for="event-official-website">Official website</label>
                        <div class="website-input">
                            <span class="website-link-slot">
                                @if (IsValidWebsiteUrl(this.EventOfficialWebsiteUrl))
                                {
                                    <a class="icon-button website-open-link" href="@this.EventOfficialWebsiteUrl" target="_blank" rel="noopener noreferrer" title="Open official website in a new tab" aria-label="Open official website in a new tab">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M21 14v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7" /></svg>
                                    </a>
                                }
                            </span>
                            <input id="event-official-website" type="url" maxlength="2048" @bind="this.EventOfficialWebsiteUrl" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="website-field">
                        <label for="event-call-for-papers-website">Call for paper website</label>
                        <div class="website-input">
                            <span class="website-link-slot">
                                @if (IsValidWebsiteUrl(this.EventCallForPapersUrl))
                                {
                                    <a class="icon-button website-open-link" href="@this.EventCallForPapersUrl" target="_blank" rel="noopener noreferrer" title="Open call for paper website in a new tab" aria-label="Open call for paper website in a new tab">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M21 14v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7" /></svg>
                                    </a>
                                }
                            </span>
                            <input id="event-call-for-papers-website" type="url" maxlength="2048" @bind="this.EventCallForPapersUrl" @bind:event="oninput" @bind:after="this.RefreshEventOverlapAsync" />
                        </div>
                    </div>
                    <label>Event Start date<input type="date" required @bind="this.EventStartDate" @bind:after="this.OnEventStartDateChangedAsync" /></label>
                    <label>Event End date<input type="date" required @bind="this.EventEndDate" @bind:after="this.RefreshEventOverlapAsync" /></label>
                    <label>Call for papers deadline<input type="date" @bind="this.EventCallForPapersDeadline" /></label>
                    <label class="span-all">Costs <span class="muted">One item per line, formatted as name=amount</span><textarea rows="4" placeholder="Travel=250.00&#10;Hotel=600.00" @bind="this.EventCosts"></textarea></label>
                </div>
                @if (this.HasEventOverlap)
                {
                    <p class="notice notice-warning" role="status">The selected dates overlap another event in your calendar.</p>
                }
                else if (this.EventOverlapCheckError is not null)
                {
                    <p class="notice notice-warning" role="status">Unable to check for overlapping events. You can still save this event.</p>
                }
                @if (this.HasDuplicateEvent)
                {
                    <p class="notice notice-warning" role="status">An event with the same title or call-for-papers URL and dates already exists.</p>
                }
                else if (this.DuplicateEventCheckError is not null)
                {
                    <p class="notice notice-warning" role="status">Unable to check for duplicate events. You can still save this event.</p>
                }
                <div class="form-actions"><button class="button button-primary" type="submit">Save event</button><button class="button button-quiet" type="button" @onclick="CloseEventEditor">Discard</button></div>
            </form>
        </section>
    </div>
}

@code {
    private readonly Dictionary<Guid, IReadOnlyList<SessionProposalDto>> Proposals = [];
    private readonly Dictionary<Guid, IReadOnlyList<string>> ProposalStatuses = [];
    private readonly Dictionary<int, IReadOnlyList<CalendarEventDto>> CalendarEventsByYear = [];
    private List<EventDto> EventItems = [];
    private string SearchYear = DateTime.Today.Year.ToString(CultureInfo.InvariantCulture);
    private string SearchName = string.Empty;
    private string SearchLocation = string.Empty;
    private Guid? ExpandedEventId;
    private bool IsLoading;
    private int EventSearchRequestVersion;
    private bool IsEventEditorOpen;
    private bool HasEventOverlap;
    private bool HasDuplicateEventTitle;
    private bool HasDuplicateEventCallForPapers;
    private bool HasDuplicateEvent => this.HasDuplicateEventTitle || this.HasDuplicateEventCallForPapers;
    private int EventOverlapRequestVersion;
    private string? EventOverlapCheckError;
    private int DuplicateEventNameRequestVersion;
    private string? DuplicateEventCheckError;
    private Guid? EventEditorId;
    private string EventName = string.Empty;
    private string EventLocation = string.Empty;
    private string EventOfficialWebsiteUrl = string.Empty;
    private string EventCallForPapersUrl = string.Empty;
    private DateTime? EventCallForPapersDeadline;
    private DateTime EventStartDate = DateTime.Today;
    private DateTime EventEndDate = DateTime.Today;
    private string EventCosts = string.Empty;
    // AI extraction feature flag and UI state
    private bool IsAiExtractionEnabled
    {
        get
        {
            var config = ServiceProvider.GetService<IConfiguration>();
            if (config is null) return false;
            return bool.TryParse(config["Features:AiExtraction"], out var v) && v;
        }
    }
    private bool IsEventCreateMenuOpen;
    private bool IsAiExtractionDialogOpen;
    private string ExtractSourcePageUrl = string.Empty;
    private bool IsExtracting;
    private string? ExtractError;
    private Guid? ProposalEditorEventId;
    private Guid? ProposalEditorId;
    private string ProposalTitle = string.Empty;
    private string ProposalNotes = string.Empty;
    private string ProposalAbstract = string.Empty;
    private DateOnly? ProposalSubmissionDate;
    private string? ErrorMessage;
    private string? EventEditorErrorMessage;
    private string? SuccessMessage;

    private static bool IsValidWebsiteUrl(string value) =>
        Uri.IsWellFormedUriString(value, UriKind.Absolute)
        && Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
        && !string.IsNullOrEmpty(uri.Host);

    protected override async Task OnInitializedAsync() => await this.LoadEventsAsync();

    private async Task SearchAsync()
    {
        this.SuccessMessage = null;
        await this.LoadEventsAsync();
    }

    private async Task LoadEventsAsync()
    {
        if (!int.TryParse(this.SearchYear, CultureInfo.InvariantCulture, out var year) || year is < 1 or > 9999)
        {
            this.ErrorMessage = "Enter a valid four-digit year.";
            return;
        }

        var requestVersion = ++this.EventSearchRequestVersion;
        this.IsLoading = true;
        this.ErrorMessage = null;
        try
        {
            var result = await this.Api.SearchEventsAsync(new EventSearchRequest(year, NullIfEmpty(this.SearchName), NullIfEmpty(this.SearchLocation)));
            if (requestVersion != this.EventSearchRequestVersion)
            {
                return;
            }

            this.EventItems = result.Items.ToList();
            this.ProposalStatuses.Clear();
            this.Proposals.Clear();
            if (!this.EventItems.Any(eventItem => eventItem.Id == this.ExpandedEventId))
            {
                this.ExpandedEventId = null;
                this.CloseProposalEditor();
            }

            if (this.EventItems.Count > 0)
            {
                try
                {
                    var calendar = await this.Api.GetCalendarAsync(year);
                    if (requestVersion != this.EventSearchRequestVersion)
                    {
                        return;
                    }

                    var visibleIds = this.EventItems.Select(eventItem => eventItem.Id).ToHashSet();
                    foreach (var eventItem in calendar.Where(eventItem => visibleIds.Contains(eventItem.EventId)))
                    {
                        this.ProposalStatuses[eventItem.EventId] = eventItem.ProposalStatuses;
                    }
                }
                catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
                {
                    if (requestVersion == this.EventSearchRequestVersion)
                    {
                        this.ErrorMessage = $"Unable to load proposal summaries. {exception.Message}";
                    }
                }
            }

            if (requestVersion == this.EventSearchRequestVersion && this.ExpandedEventId is Guid expandedId)
            {
                await this.RefreshProposalsAsync(expandedId);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            if (requestVersion == this.EventSearchRequestVersion)
            {
                this.ErrorMessage = $"Unable to load events. {exception.Message}";
            }
        }
        finally
        {
            if (requestVersion == this.EventSearchRequestVersion)
            {
                this.IsLoading = false;
            }
        }
    }

    private async Task BeginCreateEvent()
    {
        this.ResetEventEditor();
        this.IsEventEditorOpen = true;
        await this.RefreshEventOverlapAsync();
        await this.RefreshDuplicateEventNameAsync();
    }

    private void ResetEventEditor()
    {
        this.CloseEventCreateMenu();
        this.ErrorMessage = null;
        this.EventEditorErrorMessage = null;
        this.SuccessMessage = null;
        this.CalendarEventsByYear.Clear();
        this.EventEditorId = null;
        this.EventName = this.EventLocation = this.EventOfficialWebsiteUrl = this.EventCallForPapersUrl = this.EventCosts = string.Empty;
        this.EventCallForPapersDeadline = null;
        this.EventStartDate = this.EventEndDate = DateTime.Today;
        this.HasDuplicateEventTitle = false;
        this.HasDuplicateEventCallForPapers = false;
        this.DuplicateEventCheckError = null;
    }

    private async Task BeginEditEvent(EventDto eventItem)
    {
        this.ErrorMessage = null;
        this.EventEditorErrorMessage = null;
        this.SuccessMessage = null;
        this.CalendarEventsByYear.Clear();
        this.EventEditorId = eventItem.Id;
        this.EventName = eventItem.Name;
        this.EventLocation = eventItem.Location;
        this.EventOfficialWebsiteUrl = eventItem.OfficialWebsiteUrl ?? string.Empty;
        this.EventCallForPapersUrl = eventItem.CallForPapersUrl ?? string.Empty;
        this.EventCallForPapersDeadline = eventItem.CallForPapersDeadline?.ToDateTime(TimeOnly.MinValue);
        this.EventStartDate = eventItem.StartDate.ToDateTime(TimeOnly.MinValue);
        this.EventEndDate = eventItem.EndDate.ToDateTime(TimeOnly.MinValue);
        this.EventCosts = string.Join(Environment.NewLine, eventItem.Costs.Select(cost => $"{cost.Key}={cost.Value.ToString(CultureInfo.InvariantCulture)}"));
        this.IsEventEditorOpen = true;
        await this.RefreshEventOverlapAsync();
        await this.RefreshDuplicateEventNameAsync();
    }

    private async Task RefreshEventOverlapAsync()
    {
        var requestVersion = ++this.EventOverlapRequestVersion;
        this.HasEventOverlap = false;
        this.HasDuplicateEventCallForPapers = false;
        this.EventOverlapCheckError = null;
        if (!this.IsEventEditorOpen)
        {
            return;
        }

        var startDate = DateOnly.FromDateTime(this.EventStartDate);
        var endDate = DateOnly.FromDateTime(this.EventEndDate);
        if (endDate < startDate)
        {
            return;
        }

        try
        {
            var years = Enumerable.Range(startDate.Year, endDate.Year - startDate.Year + 1).ToArray();
            foreach (var year in years)
            {
                if (this.CalendarEventsByYear.ContainsKey(year))
                {
                    continue;
                }

                var calendarEvents = await this.Api.GetCalendarAsync(year);
                if (requestVersion != this.EventOverlapRequestVersion)
                {
                    return;
                }

                this.CalendarEventsByYear[year] = calendarEvents;
            }

            if (requestVersion != this.EventOverlapRequestVersion)
            {
                return;
            }

            var eventsToCheck = years
                .SelectMany(year => this.CalendarEventsByYear[year])
                .DistinctBy(eventItem => eventItem.EventId)
                .ToArray();
            this.HasEventOverlap = EventOverlapDetector.HasOverlap(
                eventsToCheck, startDate, endDate, this.EventEditorId);
            this.HasDuplicateEventCallForPapers = EventDuplicateDetector.HasSameCallForPapersAndDates(
                eventsToCheck, this.EventCallForPapersUrl, startDate, endDate, this.EventEditorId);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            if (requestVersion == this.EventOverlapRequestVersion)
            {
                this.EventOverlapCheckError = exception.Message;
            }
        }
        finally
        {
        }
    }

    private async Task RefreshDuplicateEventNameAsync()
    {
        var requestVersion = ++this.DuplicateEventNameRequestVersion;
        this.HasDuplicateEventTitle = false;
        this.DuplicateEventCheckError = null;
        var title = this.EventName.Trim();
        if (!this.IsEventEditorOpen || title.Length == 0)
        {
            return;
        }

        try
        {
            const int pageSize = 100;
            var page = 1;
            var totalCount = 0;
            do
            {
                var result = await this.Api.SearchEventsAsync(new EventSearchRequest(
                    Name: title, Page: page, PageSize: pageSize));
                if (requestVersion != this.DuplicateEventNameRequestVersion)
                {
                    return;
                }

                if (EventDuplicateDetector.HasSameTitle(result.Items, title, this.EventEditorId))
                {
                    this.HasDuplicateEventTitle = true;
                    return;
                }

                totalCount = result.TotalCount;
                page++;
            }
            while ((page - 1) * pageSize < totalCount);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            if (requestVersion == this.DuplicateEventNameRequestVersion)
            {
                this.DuplicateEventCheckError = exception.Message;
            }
        }
    }

    private async Task OnEventStartDateChangedAsync()
    {
        this.EventEndDate = this.EventStartDate;
        await this.RefreshEventOverlapAsync();
    }

    private async Task SaveEventAsync()
    {
        this.ErrorMessage = null;
        this.EventEditorErrorMessage = null;
        if (this.EventEndDate.Date < this.EventStartDate.Date)
        {
            this.EventEditorErrorMessage = "The end date cannot be before the start date.";
            return;
        }

        if (this.EventCallForPapersDeadline is DateTime callForPapersDeadline && callForPapersDeadline.Date > this.EventEndDate.Date)
        {
            this.EventEditorErrorMessage = "The call for papers deadline must be on or before the event end date.";
            return;
        }

        try
        {
            var startDate = DateOnly.FromDateTime(this.EventStartDate);
            var endDate = DateOnly.FromDateTime(this.EventEndDate);
            var request = new SaveEventRequest(
                this.EventName.Trim(), this.EventLocation.Trim(), startDate, endDate, ParseCosts(this.EventCosts),
                NullIfEmpty(this.EventOfficialWebsiteUrl), NullIfEmpty(this.EventCallForPapersUrl),
                this.EventCallForPapersDeadline is DateTime deadline ? DateOnly.FromDateTime(deadline) : null);
            if (this.EventEditorId is Guid eventId)
            {
                await this.Api.UpdateEventAsync(eventId, request);
                this.SuccessMessage = "Event updated.";
            }
            else
            {
                await this.Api.CreateEventAsync(request);
                this.SuccessMessage = "Event created.";
            }

            this.CloseEventEditor();
            await this.LoadEventsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or FormatException or ArgumentException)
        {
            this.EventEditorErrorMessage = $"Unable to save event. {exception.Message}";
        }
    }

    private async Task ExtractEventDataAsync()
    {
        if (!this.IsAiExtractionEnabled || !this.IsAiExtractionDialogOpen || this.IsExtracting)
        {
            return;
        }

        this.ExtractError = null;
        var sourcePageUrl = this.ExtractSourcePageUrl.Trim();
        if (!IsValidWebsiteUrl(sourcePageUrl))
        {
            this.ExtractError = "Enter a valid HTTP or HTTPS URL to extract from.";
            return;
        }

        this.IsExtracting = true;
        try
        {
            var result = await this.Api.ExtractEventDataAsync(new ExtractEventDataRequest(sourcePageUrl));

            this.ResetEventEditor();
            this.EventName = result.Name ?? string.Empty;
            this.EventLocation = result.Location ?? string.Empty;
            this.EventOfficialWebsiteUrl = result.OfficialWebsiteUrl ?? string.Empty;
            this.EventCallForPapersUrl = result.CallForPapersUrl ?? string.Empty;

            if (TryParseDateString(result.CallForPapersDeadline, out var deadline))
            {
                this.EventCallForPapersDeadline = deadline;
            }

            if (TryParseDateString(result.StartDate, out var start))
            {
                this.EventStartDate = this.EventEndDate = start;
            }

            if (TryParseDateString(result.EndDate, out var end))
            {
                this.EventEndDate = end;
            }

            this.SuccessMessage = "Extraction applied (partial values may be empty).";
            this.IsAiExtractionDialogOpen = false;
            this.IsEventEditorOpen = true;
            await this.RefreshEventOverlapAsync();
            await this.RefreshDuplicateEventNameAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            this.ExtractError = exception.Message;
        }
        finally
        {
            this.IsExtracting = false;
            StateHasChanged();
        }
    }

    private static bool TryParseDateString(string? dateStr, out DateTime parsed)
    {
        parsed = default;
        if (string.IsNullOrWhiteSpace(dateStr))
        {
            return false;
        }

        // Try common formats: dd/MM/yyyy per Foundry plan, ISO, and RFC
        var formats = new[] { "dd/MM/yyyy", "d/M/yyyy", "yyyy-MM-dd", "yyyy-MM-ddTHH:mm:ssZ", "MM/dd/yyyy" };
        if (DateTime.TryParseExact(dateStr, formats, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var dt))
        {
            parsed = dt;
            return true;
        }

        if (DateTime.TryParse(dateStr, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out dt))
        {
            parsed = dt;
            return true;
        }

        return false;
    }

    private void OpenExtractionDialog()
    {
        if (!this.IsAiExtractionEnabled)
        {
            return;
        }

        this.CloseEventCreateMenu();
        this.CloseEventEditor();
        this.ErrorMessage = null;
        this.SuccessMessage = null;
        this.ExtractError = null;
        this.ExtractSourcePageUrl = string.Empty;
        this.IsAiExtractionDialogOpen = true;
    }

    private void CloseExtractionDialog()
    {
        if (this.IsExtracting)
        {
            return;
        }

        this.IsAiExtractionDialogOpen = false;
        this.ExtractError = null;
    }

    private void ToggleEventCreateMenu() => this.IsEventCreateMenuOpen = !this.IsEventCreateMenuOpen;

    private void CloseEventCreateMenu() => this.IsEventCreateMenuOpen = false;

    private void HandleEventCreateKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            this.CloseEventCreateMenu();
        }
    }

    private async Task DeleteEventAsync(EventDto eventItem)
    {
        if (!await this.JavaScript.InvokeAsync<bool>("confirm", $"Delete {eventItem.Name} and its proposals?"))
        {
            return;
        }

        try
        {
            await this.Api.DeleteEventAsync(eventItem.Id);
            this.Proposals.Remove(eventItem.Id);
            this.ProposalStatuses.Remove(eventItem.Id);
            this.SuccessMessage = "Event and its proposals deleted.";
            await this.LoadEventsAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            this.ErrorMessage = $"Unable to delete event. {exception.Message}";
        }
    }

    private async Task ToggleProposalsAsync(Guid eventId)
    {
        this.ErrorMessage = null;
        if (this.ExpandedEventId == eventId)
        {
            this.ExpandedEventId = null;
            this.CloseProposalEditor();
            return;
        }

        this.ExpandedEventId = eventId;
        try
        {
            await this.RefreshProposalsAsync(eventId);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            this.ErrorMessage = $"Unable to load proposals. {exception.Message}";
        }
    }

    private async Task RefreshProposalsAsync(Guid eventId)
    {
        var requestVersion = this.EventSearchRequestVersion;
        var proposals = await this.Api.ListProposalsAsync(eventId);
        if (requestVersion != this.EventSearchRequestVersion)
        {
            return;
        }

        this.Proposals[eventId] = proposals;
        this.ProposalStatuses[eventId] = proposals.Select(proposal => proposal.Status.ToString()).ToArray();
    }

    private void BeginCreateProposal(Guid eventId)
    {
        this.ErrorMessage = null;
        this.ProposalEditorEventId = eventId;
        this.ProposalEditorId = null;
        this.ProposalTitle = this.ProposalAbstract = this.ProposalNotes = string.Empty;
        this.ProposalSubmissionDate = null;
    }

    private void BeginEditProposal(Guid eventId, SessionProposalDto proposal)
    {
        this.ErrorMessage = null;
        this.ProposalEditorEventId = eventId;
        this.ProposalEditorId = proposal.Id;
        this.ProposalTitle = proposal.Title;
        this.ProposalAbstract = proposal.Abstract ?? string.Empty;
        this.ProposalNotes = proposal.Notes;
        this.ProposalSubmissionDate = proposal.SubmissionDate;
    }

    private async Task SaveProposalAsync()
    {
        if (this.ProposalEditorEventId is not Guid eventId)
        {
            return;
        }

        try
        {
            var request = new SaveSessionProposalRequest(
                this.ProposalTitle.Trim(), this.ProposalAbstract.Trim(), this.ProposalNotes.Trim(), this.ProposalSubmissionDate);
            if (this.ProposalEditorId is Guid proposalId)
            {
                await this.Api.UpdateProposalAsync(eventId, proposalId, request);
                this.SuccessMessage = "Proposal updated.";
            }
            else
            {
                await this.Api.CreateProposalAsync(eventId, request);
                this.SuccessMessage = "Proposal added.";
            }

            this.CloseProposalEditor();
            await this.RefreshProposalsAsync(eventId);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or ArgumentException)
        {
            this.ErrorMessage = $"Unable to save proposal. {exception.Message}";
        }
    }

    private async Task UpdateProposalStatusAsync(Guid eventId, SessionProposalDto proposal, string? statusValue)
    {
        if (!int.TryParse(statusValue, CultureInfo.InvariantCulture, out var statusNumber)
            || !Enum.IsDefined(typeof(ProposalStatus), statusNumber))
        {
            return;
        }

        try
        {
            await this.Api.ChangeProposalStatusAsync(eventId, proposal.Id, new ChangeProposalStatusRequest((ProposalStatus)statusNumber));
            await this.RefreshProposalsAsync(eventId);
            this.SuccessMessage = "Proposal status updated.";
            this.ErrorMessage = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            this.ErrorMessage = $"Unable to change proposal status. {exception.Message}";
        }
    }

    private async Task DeleteProposalAsync(Guid eventId, SessionProposalDto proposal)
    {
        if (!await this.JavaScript.InvokeAsync<bool>("confirm", $"Delete the proposal '{proposal.Title}'? This action cannot be undone."))
        {
            return;
        }

        try
        {
            await this.Api.DeleteProposalAsync(eventId, proposal.Id);
            await this.RefreshProposalsAsync(eventId);
            this.SuccessMessage = "Proposal deleted.";
            this.ErrorMessage = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException)
        {
            this.ErrorMessage = $"Unable to delete proposal. {exception.Message}";
        }
    }

    private void CloseEventEditor()
    {
        this.EventOverlapRequestVersion++;
        this.DuplicateEventNameRequestVersion++;
        this.HasEventOverlap = false;
        this.HasDuplicateEventTitle = false;
        this.HasDuplicateEventCallForPapers = false;
        this.EventOverlapCheckError = null;
        this.DuplicateEventCheckError = null;
        this.EventEditorErrorMessage = null;
        this.IsEventEditorOpen = false;
    }

    private void CloseProposalEditor()
    {
        this.ProposalEditorEventId = null;
        this.ProposalEditorId = null;
    }

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static IReadOnlyDictionary<string, decimal> ParseCosts(string value)
    {
        var costs = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
        foreach (var line in value.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var separator = line.IndexOf('=');
            if (separator < 1 || !decimal.TryParse(line[(separator + 1)..].Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var amount))
            {
                throw new FormatException($"Invalid cost entry '{line}'. Use name=amount, for example Travel=250.00.");
            }

            costs[line[..separator].Trim()] = amount;
        }

        return costs;
    }
}