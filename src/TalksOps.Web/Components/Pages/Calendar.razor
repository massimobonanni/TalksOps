@page "/calendar"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ITalksOpsApiClient Api
@inject IJSRuntime JavaScript

<PageTitle>Calendar | TalksOps</PageTitle>

<div class="page-heading">
    <div><p class="eyebrow">YEAR AT A GLANCE</p><h1>Speaking calendar</h1></div>
    <div class="year-control"><button class="icon-button" aria-label="Previous year" @onclick="() => ChangeYearAsync(-1)">&larr;</button><strong>@this.Year</strong><button class="icon-button" aria-label="Next year" @onclick="() => ChangeYearAsync(1)">&rarr;</button></div>
</div>

<div class="calendar-status-filters" role="group" aria-label="Filter events by proposal status">
    <span class="calendar-status-filter-label">Filter by proposal status</span>
    @foreach (var status in ProposalStatusFilters)
    {
        var isSelected = this.SelectedProposalStatuses.Contains(status);
        <button type="button"
                class="calendar-status-filter"
                aria-pressed="@(isSelected ? "true" : "false")"
                @onclick="() => this.ToggleProposalStatus(status)">
            <i class="calendar-dot @CalendarStateClassifier.GetProposalState(status)" aria-hidden="true"></i>
            @status
        </button>
    }
    @if (this.SelectedProposalStatuses.Count > 0)
    {
        <button type="button" class="calendar-status-filter calendar-status-filter-clear" @onclick="this.ClearProposalStatusFilters">
            Clear filters
        </button>
    }
</div>
<p class="calendar-note">Each circle represents a proposal and its current status. Event borders follow this precedence: Accepted, Submitted, Rejected, then Cancelled. A red outline groups events with overlapping dates.</p>

@{
    var filteredEvents = this.Events
        .Where(eventItem => CalendarStateClassifier.MatchesStatusFilter(eventItem.ProposalStatuses, this.SelectedProposalStatuses))
        .ToArray();
}

@if (!string.IsNullOrWhiteSpace(this.ErrorMessage))
{
    <div class="notice notice-error" role="alert">@this.ErrorMessage</div>
}
else if (this.IsLoading)
{
    <p class="empty-state">Loading calendar...</p>
}
else if (this.Events.Count == 0)
{
    <section class="empty-state"><h2>No events in @this.Year</h2><p>Events in this year will appear here.</p></section>
}
else if (filteredEvents.Length == 0)
{
    <section class="empty-state" role="status">
        <h2>No events match the selected statuses</h2>
        <p>Try selecting different proposal statuses or clear the filters.</p>
    </section>
}
else
{
    <div class="calendar-months">
        @foreach (var monthNumber in Enumerable.Range(1, 12))
        {
            var monthStart = new DateOnly(this.Year, monthNumber, 1);
            var monthEnd = new DateOnly(this.Year, monthNumber, DateTime.DaysInMonth(this.Year, monthNumber));
            var monthEvents = filteredEvents
                .Where(eventItem => eventItem.StartDate <= monthEnd && eventItem.EndDate >= monthStart)
                .ToList();
            <section class="calendar-month">
                <h2>@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(monthNumber)</h2>
                @if (monthEvents.Count == 0)
                {
                    <p class="month-empty">@(this.SelectedProposalStatuses.Count > 0 ? "No events match selected statuses" : "No events")</p>
                }
                else
                {
                    @foreach (var group in EventOverlapDetector.GroupOverlappingEvents(monthEvents))
                    {
                        <div class="@(group.Count > 1 ? "calendar-overlap-group" : null)"
                             role="@(group.Count > 1 ? "group" : null)"
                             aria-label="@(group.Count > 1 ? "Events with overlapping dates" : null)">
                            @foreach (var eventItem in group)
                            {
                                var state = CalendarStateClassifier.GetState(eventItem.ProposalStatuses);
                                var deadlineStatus = eventItem.CallForPapersDeadline is DateOnly deadline
                                    ? CallForPapersDeadlineClassifier.Classify(deadline, DateOnly.FromDateTime(DateTime.Today))
                                    : (CallForPapersDeadlineStatus?)null;
                                <article class="calendar-event state-@state">
                                    <span class="calendar-date">@eventItem.StartDate.ToString("MMM d")@(eventItem.EndDate != eventItem.StartDate ? $" - {eventItem.EndDate:MMM d}" : string.Empty)</span>
                                    <div>
                                        <h3>
                                            @if (!string.IsNullOrWhiteSpace(eventItem.OfficialWebsiteUrl))
                                            {
                                                <a class="event-title-link" href="@eventItem.OfficialWebsiteUrl" target="_blank" rel="noopener noreferrer">@eventItem.EventName</a>
                                            }
                                            else
                                            {
                                                @eventItem.EventName
                                            }
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(eventItem.CallForPapersUrl))
                                        {
                                            <div class="calendar-cfp-row">
                                                <a class="call-for-papers-link @(deadlineStatus?.ColorClass ?? "deadline-unset")" href="@eventItem.CallForPapersUrl" target="_blank" rel="noopener noreferrer">call for paper</a>
                                                @if (deadlineStatus is { } status)
                                                {
                                                    <span class="status-pill deadline-count @status.ColorClass">@status.RemainingLabel</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="calendar-event-actions">
                                        @if (eventItem.ProposalStatuses.Count > 0)
                                        {
                                            <span class="proposal-indicators" aria-label="@($"{eventItem.ProposalStatuses.Count} session proposals")">
                                                @foreach (var status in eventItem.ProposalStatuses)
                                                {
                                                    <span class="calendar-dot @CalendarStateClassifier.GetProposalState(status)" role="img" title="@status" aria-label="@($"Proposal status: {status}")"></span>
                                                }
                                            </span>
                                        }
                                        <button type="button" class="icon-button calendar-details-button" title="View event details" aria-label="@($"View details for {eventItem.EventName}")" aria-haspopup="dialog" @onclick="() => OpenEventDetailsAsync(eventItem)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
                                        </button>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            </section>
        }
    </div>
}

<dialog @ref="this.detailsDialog" class="dialog event-dialog calendar-event-dialog" aria-labelledby="calendar-details-title">
    @if (this.SelectedCalendarEvent is not null)
    {
        <div class="detail-heading">
            <h2 id="calendar-details-title">@(this.EventDetails?.Name ?? this.SelectedCalendarEvent.EventName)</h2>
            <button type="button" class="icon-button calendar-details-close" title="Close" aria-label="Close event details" autofocus @onclick="CloseEventDetails">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m18 6-12 12M6 6l12 12" /></svg>
            </button>
        </div>
        @if (this.IsLoadingDetails)
        {
            <p role="status">Loading event details...</p>
        }
        else if (this.DetailsError is not null)
        {
            <p class="notice notice-error" role="alert">@this.DetailsError</p>
            <button type="button" class="button button-secondary" @onclick="() => OpenEventDetailsAsync(this.SelectedCalendarEvent)">Retry</button>
        }
        else if (this.EventDetails is { } details)
        {
            <dl class="calendar-details-grid">
                <div><dt>Location</dt><dd>@details.Location</dd></div>
                <div><dt>Dates</dt><dd>@details.StartDate.ToString("MMM d, yyyy") - @details.EndDate.ToString("MMM d, yyyy")</dd></div>
                <div><dt>Official website</dt><dd>@if (!string.IsNullOrWhiteSpace(details.OfficialWebsiteUrl)) { <a href="@details.OfficialWebsiteUrl" target="_blank" rel="noopener noreferrer">@details.OfficialWebsiteUrl</a> } else { <span>Not specified</span> }</dd></div>
                <div><dt>Call for papers</dt><dd>@if (!string.IsNullOrWhiteSpace(details.CallForPapersUrl)) { <a href="@details.CallForPapersUrl" target="_blank" rel="noopener noreferrer">@details.CallForPapersUrl</a> } else { <span>Not specified</span> }</dd></div>
                <div><dt>Call for papers deadline</dt><dd>@(details.CallForPapersDeadline?.ToString("MMM d, yyyy") ?? "Not specified")</dd></div>
                <div><dt>Costs</dt><dd>
                    @if (details.Costs.Count == 0) { <span>No costs recorded</span> }
                    else
                    {
                        @foreach (var cost in details.Costs.OrderBy(cost => cost.Key)) { <div>@cost.Key: @cost.Value.ToString("0.00", CultureInfo.InvariantCulture)</div> }
                        <strong>Total: @details.TotalCosts.ToString("0.00", CultureInfo.InvariantCulture)</strong>
                    }
                </dd></div>
            </dl>
            <h3>Session proposals (@this.EventProposals.Count)</h3>
            @if (this.EventProposals.Count == 0)
            {
                <p class="muted">No session proposals for this event.</p>
            }
            else
            {
                <div class="calendar-session-list">
                    @foreach (var proposal in this.EventProposals)
                    {
                        <article class="calendar-session" @key="proposal.Id">
                            <div class="calendar-session-heading"><h4>@proposal.Title</h4><span class="status-pill status-@CalendarStateClassifier.GetProposalState(proposal.Status.ToString())">@proposal.Status</span></div>
                            <a class="icon-button feedback-management-link" href="@($"/events/{details.Id:D}/proposals/{proposal.Id:D}/feedback")" aria-label="Feedback" title="Feedback"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M13,30H11V13a5,5,0,0,1,5-5h5v2H16a3,3,0,0,0-3,3ZM51,55a3,3,0,0,1-3,3H16a3,3,0,0,1-3-3V48H11v7a5,5,0,0,0,5,5H48a5,5,0,0,0,5-5V48.16H51Zm0-42V30h2V13a5,5,0,0,0-5-5H43v2h5A3,3,0,0,1,51,13ZM15,13V35h2V14h4V12H16A1,1,0,0,0,15,13Zm0,37.11V55a1,1,0,0,0,1,1H48a1,1,0,0,0,1-1V49.94H47V54H17V50.11ZM47,35h2V13a1,1,0,0,0-1-1H43v2h4ZM23,17V9a1,1,0,0,1,1-1h4a4,4,0,0,1,8,0h4a1,1,0,0,1,1,1v8a1,1,0,0,1-1,1H24A1,1,0,0,1,23,17Zm2-1H39V10H35a1,1,0,0,1-1-1V8a2,2,0,0,0-4,0V9a1,1,0,0,1-1,1H25Zm4-2h6V12H29ZM22.18,38.81A1,1,0,0,1,22.77,37h6.32l2-6A1,1,0,0,1,33,31l2,6h6.32a1,1,0,0,1,.59,1.81L36.7,42.53l2,6a1,1,0,0,1-.37,1.12,1,1,0,0,1-1.17,0L32,45.94l-5.12,3.72a1,1,0,0,1-1.17,0,1,1,0,0,1-.37-1.12l2-6Zm3.66.19,3.22,2.34a1,1,0,0,1,.36,1.12L28.2,46.24l3.21-2.34a1,1,0,0,1,1.18,0l3.21,2.34-1.22-3.78a1,1,0,0,1,.36-1.12L38.16,39h-4a1,1,0,0,1-1-.69L32,34.53l-1.23,3.78a1,1,0,0,1-.95.69ZM12,45,8,48a1,1,0,0,1-1.54-1.12L8,42.12,4,39.21a1,1,0,0,1,.58-1.81h5l1.53-4.71a1,1,0,0,1,1.9,0l1.53,4.71h5a1,1,0,0,1,.95.69A1,1,0,0,1,20,39.21l-4,2.91,1.53,4.72A1,1,0,0,1,17.18,48,1,1,0,0,1,16,48Zm-.59-2a1,1,0,0,1,1.18,0l2.1,1.53-.8-2.48a1,1,0,0,1,.36-1.12l2.11-1.53h-2.6a1,1,0,0,1-1-.69L12,36.24l-.8,2.47a1,1,0,0,1-1,.69H7.64l2.11,1.53a1,1,0,0,1,.36,1.12l-.8,2.48ZM60,39.21l-4,2.91,1.53,4.72A1,1,0,0,1,57.18,48,1,1,0,0,1,56,48L52,45,48,48a1,1,0,0,1-1.54-1.12L48,42.12l-4-2.91a1,1,0,0,1,.58-1.81h5l1.53-4.71a1,1,0,0,1,1.9,0l1.53,4.71h5a1,1,0,0,1,1,.69A1,1,0,0,1,60,39.21Zm-3.66.19h-2.6a1,1,0,0,1-1-.69L52,36.24l-.8,2.47a1,1,0,0,1-1,.69h-2.6l2.11,1.53a1,1,0,0,1,.36,1.12l-.8,2.48L51.41,43a1,1,0,0,1,1.18,0l2.1,1.53-.8-2.48a1,1,0,0,1,.36-1.12Z" fill="#000000"></path></svg></a>
                            <p class="muted">Submitted: @(proposal.SubmissionDate?.ToString("MMM d, yyyy") ?? "Not specified")</p>
                            @if (!string.IsNullOrWhiteSpace(proposal.Abstract))
                            {
                                <p>@proposal.Abstract</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(proposal.Notes))
                            {
                                <p class="muted">@proposal.Notes</p>
                            }
                        </article>
                    }
                </div>
            }
        }
    }
</dialog>

@code {
    private static readonly string[] ProposalStatusFilters = ["Accepted", "Submitted", "Rejected", "Cancelled"];
    private int Year = DateTime.Today.Year;
    private IReadOnlyList<CalendarEventDto> Events = [];
    private HashSet<string> SelectedProposalStatuses = new(StringComparer.OrdinalIgnoreCase);
    private bool IsLoading;
    private string? ErrorMessage;
    private CalendarEventDto? SelectedCalendarEvent;
    private EventDto? EventDetails;
    private IReadOnlyList<SessionProposalDto> EventProposals = [];
    private bool IsLoadingDetails;
    private string? DetailsError;
    private int detailsRequestVersion;
    private ElementReference detailsDialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<Calendar>? callbackReference;
    private bool disposed;

    protected override async Task OnInitializedAsync() => await this.LoadCalendarAsync();

    private void ToggleProposalStatus(string status)
    {
        if (!this.SelectedProposalStatuses.Add(status))
        {
            this.SelectedProposalStatuses.Remove(status);
        }
    }

    private void ClearProposalStatusFilters() => this.SelectedProposalStatuses.Clear();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (this.disposed)
        {
            return;
        }

        if (this.module is null)
        {
            this.module = await this.JavaScript.InvokeAsync<IJSObjectReference>(
                "import", $"./{Assets["Components/Pages/Calendar.razor.js"]}");
            this.callbackReference = DotNetObjectReference.Create(this);
            await this.module.InvokeVoidAsync("initialize", this.detailsDialog, this.callbackReference);
        }

        if (!this.disposed)
        {
            await this.module.InvokeVoidAsync("setOpen", this.detailsDialog, this.SelectedCalendarEvent is not null);
        }
    }

    private async Task OpenEventDetailsAsync(CalendarEventDto eventItem)
    {
        var requestVersion = ++this.detailsRequestVersion;
        this.SelectedCalendarEvent = eventItem;
        this.EventDetails = null;
        this.EventProposals = [];
        this.DetailsError = null;
        this.IsLoadingDetails = true;
        try
        {
            var eventTask = this.Api.GetEventAsync(eventItem.EventId);
            var proposalsTask = this.Api.ListProposalsAsync(eventItem.EventId);
            await Task.WhenAll(eventTask, proposalsTask);
            if (requestVersion != this.detailsRequestVersion)
            {
                return;
            }

            this.EventDetails = await eventTask;
            this.EventProposals = (await proposalsTask).OrderBy(proposal => proposal.Title).ThenBy(proposal => proposal.Id).ToArray();
            if (this.EventDetails is null)
            {
                this.DetailsError = "This event is no longer available.";
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            if (requestVersion == this.detailsRequestVersion)
            {
                this.DetailsError = $"Unable to load event details. {exception.Message}";
            }
        }
        finally
        {
            if (requestVersion == this.detailsRequestVersion)
            {
                this.IsLoadingDetails = false;
            }
        }
    }

    private void CloseEventDetails()
    {
        this.detailsRequestVersion++;
        this.SelectedCalendarEvent = null;
        this.EventDetails = null;
        this.EventProposals = [];
        this.DetailsError = null;
        this.IsLoadingDetails = false;
    }

    /// <summary>Closes the details dialog when dismissed by the browser.</summary>
    [JSInvokable]
    public Task DismissDetailsAsync() => this.InvokeAsync(() =>
    {
        this.CloseEventDetails();
        this.StateHasChanged();
    });

    private async Task ChangeYearAsync(int offset)
    {
        if (this.Year + offset is < 1 or > 9999)
        {
            return;
        }

        this.CloseEventDetails();
        this.Year += offset;
        await this.LoadCalendarAsync();
    }

    private async Task LoadCalendarAsync()
    {
        this.IsLoading = true;
        this.ErrorMessage = null;
        try
        {
            this.Events = await this.Api.GetCalendarAsync(this.Year);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            this.ErrorMessage = $"Unable to load calendar. {exception.Message}";
        }
        finally
        {
            this.IsLoading = false;
        }
    }

    /// <summary>Releases the dialog interop resources and invalidates pending requests.</summary>
    public async ValueTask DisposeAsync()
    {
        this.disposed = true;
        this.CloseEventDetails();
        if (this.module is not null)
        {
            try
            {
                await this.module.InvokeVoidAsync("dispose", this.detailsDialog);
                await this.module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        this.callbackReference?.Dispose();
    }
}